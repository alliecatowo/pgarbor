{
  "name": "pgarbor-fixture-node-pg",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Plain node-postgres + node-pg-migrate app (blog/shop style schema)",
  "scripts": {
    "migrate": "node-pg-migrate up --migrations-dir migrations --migration-file-language ts --tsconfig tsconfig.json",
    "migrate:down": "node-pg-migrate down --migrations-dir migrations --migration-file-language ts --tsconfig tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/run-tests.ts"
  },
  "dependencies": {
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
