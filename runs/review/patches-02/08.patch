+            pgarbor_catalog::FollowUp::PopulateMatView { relation } => {
+                populated = Some(crate::ctas::populate_matview(cx, *relation)?);
+            }
+            other => run_followups(cx, std::slice::from_ref(other), None, &[])?,
+        }
+    }
+    Ok(ExecResult::command(match populated {
