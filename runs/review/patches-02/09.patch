diff --git a/runs/review/analyze_embedded_02.py b/runs/review/analyze_embedded_02.py
new file mode 100644
index 00000000..7ecb439b
--- /dev/null
+++ b/runs/review/analyze_embedded_02.py
@@ -0,0 +1,62 @@
+"""Summarize full campaigns without changing raw results, cases, references, or policy."""
+import csv, hashlib, json
+from collections import Counter, defaultdict
+from pathlib import Path
+root=Path(__file__).resolve().parents[2]
+review=root/'runs/review'
+old=[json.loads(l) for l in (review/'embedded-final-01/results-verified.jsonl').read_text().splitlines()]
+new=[json.loads(l) for l in (review/'embedded-final-02/results.jsonl').read_text().splitlines()]
+assert len(new)==5837 and len({r['case_id'] for r in new})==5837
+assert {r['case_id'] for r in old}=={r['case_id'] for r in new}
+by_old={r['case_id']:r for r in old}
+by_family=defaultdict(lambda: [Counter(),Counter()])
+for i,rows in enumerate([old,new]):
+ for r in rows:
+  by_family[r['family']][i].update({'selected':1,r['outcome']:1})
+fields=['family','selected_01','pass_01','pass_rate_01_pct','selected_02','pass_02','pass_rate_02_pct','pass_delta','rate_delta_pp']
+with (review/'codex-differential-by-family-02.csv').open('w') as f:
+ w=csv.writer(f);w.writerow(fields)
+ for family,(a,b) in sorted(by_family.items()):
+  pa=100*a['PASS']/a['selected'];pb=100*b['PASS']/b['selected']
+  w.writerow([family,a['selected'],a['PASS'],f'{pa:.4f}',b['selected'],b['PASS'],f'{pb:.4f}',b['PASS']-a['PASS'],f'{pb-pa:.4f}'])
+transitions=Counter((by_old[r['case_id']]['outcome'],r['outcome']) for r in new)
+regressions=[r['case_id'] for r in new if by_old[r['case_id']]['outcome']=='PASS' and r['outcome']!='PASS']
+clusters={}
+for outcome in ['MISMATCH','CRASH','UNEXPECTED_ACCEPTANCE','UNSUPPORTED']:
+ c=Counter()
+ for r in new:
+  if r['outcome']!=outcome:continue
+  sig=r.get('signature') or {};key=sig.get('message_template') or sig.get('diff_kind') or r['reason']
+  c[key]+=1
+ clusters[outcome]=c.most_common()
+old_priority={r['case_id'] for r in old if r['outcome'] in ('CRASH','UNEXPECTED_ACCEPTANCE')}
+metrics={
+ 'baseline_counts':dict(Counter(r['outcome'] for r in old)),
+ 'final_counts':dict(Counter(r['outcome'] for r in new)),
+ 'selected':len(new),'reference_valid':sum(r['reference_valid'] for r in new),
+ 'executed':sum(r['executed'] for r in new),
+ 'pass_rate_selected_pct':100*sum(r['outcome']=='PASS' for r in new)/len(new),
+ 'pass_rate_executed_pct':100*sum(r['outcome']=='PASS' for r in new)/sum(r['executed'] for r in new),
+ 'priority_160_counts':dict(Counter(r['outcome'] for r in new if r['case_id'] in old_priority)),
+ 'transitions':[{'from':a,'to':b,'count':n} for (a,b),n in sorted(transitions.items())],
+ 'previous_pass_regressions':regressions,'clusters':clusters,
+ 'binary_sha256':json.load((review/'embedded-final-02/summary.json').open())['binary_sha256'],
+}
+# The outcome classifier alone does not cover bridge errors. Count both explicitly.
+internal=Counter(); bridge_internal=Counter()
+for record in new:
+ path=review/'embedded-final-02/transcripts'/(record['case_id']+'.json')
+ if path.exists():
+  transcript=json.load(path.open())
+  for step in transcript['setup']+transcript['steps']:
+   for result in step.get('results',[]):
+    error=result.get('error') or {}
+    if error.get('sqlstate','').startswith('XX'):internal[error['sqlstate']]+=1
+ error=record.get('bridge_error')
+ if isinstance(error,dict) and error.get('sqlstate','').startswith('XX'):bridge_internal[error['sqlstate']]+=1
+metrics['xx_errors_in_complete_transcripts']=dict(internal)
+metrics['xx_errors_in_bridge_failures']=dict(bridge_internal)
+metrics['process_failure_cases']=[r['case_id'] for r in new if r.get('reason','').startswith('embedded_exit:')]
+metrics['timeout_cases']=[r['case_id'] for r in new if r['outcome']=='HANG']
+(review/'codex-differential-summary-02.json').write_text(json.dumps(metrics,indent=2)+'\n')
+print(json.dumps({k:v for k,v in metrics.items() if k not in ('transitions','clusters')},indent=2))
diff --git a/runs/review/rerun_clusters_02.py b/runs/review/rerun_clusters_02.py
new file mode 100644
index 00000000..1753b510
--- /dev/null
+++ b/runs/review/rerun_clusters_02.py
@@ -0,0 +1,17 @@
+"""Recheck the 01 CRASH/UNEXPECTED_ACCEPTANCE cases using the unchanged embedded runner."""
+import json
+from collections import Counter
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+from pgarbor_harness.cases.loader import load_corpus
+from pgarbor_harness.runner.embedded import run_case
+root=Path(__file__).resolve().parents[2]
+old=[json.loads(l) for l in (root/'runs/review/embedded-final-01/results-verified.jsonl').read_text().splitlines()]
+ids={r['case_id'] for r in old if r['outcome'] in ('CRASH','UNEXPECTED_ACCEPTANCE')}
+out=root/'runs/review/embedded-clusters-02'
+for name in ('transcripts','errors'): (out/name).mkdir(parents=True,exist_ok=True)
+cases=[c for c in load_corpus(root/'tests/cases',root).cases if c.id in ids]
+with ThreadPoolExecutor(max_workers=4) as pool:
+ results=list(pool.map(lambda c: run_case(c,root/'target/debug/examples/embedded_case',root,out,20),cases))
+(out/'results.jsonl').write_text(''.join(json.dumps(r)+'\n' for r in results))
+print(Counter(r['outcome'] for r in results))
diff --git a/runs/review/prepare_patches_02.py b/runs/review/prepare_patches_02.py
new file mode 100644
index 00000000..1c358544
--- /dev/null
+++ b/runs/review/prepare_patches_02.py
@@ -0,0 +1,53 @@
+"""Write reviewable logical patches; never writes the Git index."""
+from pathlib import Path
+import hashlib,json,subprocess
+root=Path(__file__).resolve().parents[2]
+out=root/'runs/review/patches-02';out.mkdir(exist_ok=True)
+def files(crate,names): return [f'crates/{crate}/src/{n}.rs' for n in names.split()]
+groups=[
+ ('fix(sql): enforce PostgreSQL grammar and bind variadic builtin calls',
+  files('pgarbor-sql','lib parser strict_check syntax_error binder/expr_func')+files('pgarbor-exec','eval_call')+files('pgarbor-plan','simplify')+['crates/pgarbor/tests/sql_variadic_any_contract.rs','crates/pgarbor/tests/sql_variadic_contract.rs']),
+ ('fix(plan): preserve aggregate and join slots across query boundaries',
+  files('pgarbor-plan','agg build context cte join planner setrefs sort_limit')+files('pgarbor-sql','binder/expr_agg deparse/query')+['crates/pgarbor/tests/sql_planner_targetlist.rs','contracts/amendments/pgarbor-plan-04-query-level-parentage.md']),
+ ('fix(exec): lower ALTER USING expressions and rebind typed defaults',
+  files('pgarbor-exec','ddl_followup tabledesc')),
+ ('fix(exec): stream recursive CTEs and invalidate changed working tables',
+  files('pgarbor-exec','node_cte runtime')+['crates/pgarbor/tests/cte_scope_contract.rs','contracts/amendments/pgarbor-exec-09-recursive-cte-streaming.md']),
+ ('fix(exec): evaluate scalar expressions containing set-returning calls',
+  files('pgarbor-exec','node_func')),
+ ('fix(catalog): retain dependencies and reject invalid utility settings',
+  files('pgarbor-catalog','ddl/comment ddl/grant ddl/typedef ddl/alter_table')+files('pgarbor-sql','binder/ddl_function binder/ddl_index binder/ddl_view binder/from binder/utility')+
+  files('pgarbor-exec','context ddl_alter exec_session session_fns utility')+files('pgarbor','guc')+
+  ['crates/pgarbor/tests/sql_session_contract.rs','contracts/amendments/pgarbor-catalog-08-domain-container-validation.md','contracts/amendments/pgarbor-exec-08-guc-validation.md']),
+ ('fix(types): preserve OID representations and reject missing record descriptors',
+  files('pgarbor-types','cast/apply agg/ordered_set record')+files('pgarbor-exec','eval eval_cast')),
+ ('fix(api): report PostgreSQL session and materialized-view completion tags',
+  files('pgarbor','run_stmt')+files('pgarbor-exec','ddl_objects')),
+ ('test: record embedded review 02 and semantic regression coverage',
+  ['crates/pgarbor/tests/sql_cluster_semantics.rs','STATUS.md','runs/review/codex-final-02.md','runs/review/codex-change-audit-02.json','runs/review/codex-differential-by-family-02.csv','runs/review/codex-differential-summary-02.json','runs/review/codex-test-layers-02.json','runs/review/analyze_embedded_02.py','runs/review/rerun_clusters_02.py','runs/review/prepare_patches_02.py']),
+]
+commits=[]
+seen=set()
+for i,(message,paths) in enumerate(groups,1):
+ patch=b''
+ for name in paths:
+  assert name not in seen,name
+  seen.add(name)
+  if not (root/name).exists(): raise SystemExit('Missing deliverable: '+name)
+  tracked=subprocess.run(['git','-c','core.fsmonitor=false','ls-files','--error-unmatch','--',name],cwd=root,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL).returncode==0
+  args=['git','-c','core.fsmonitor=false','diff','--no-ext-diff','--no-textconv','--src-prefix=a/','--dst-prefix=b/']
+  args+=['HEAD','--',name] if tracked else ['--no-index','--','/dev/null',name]
+  result=subprocess.run(args,cwd=root,capture_output=True)
+  assert result.returncode in (0,1),result.stderr
+  patch+=result.stdout
+ patch_name=f'{i:02d}.patch'
+ (out/patch_name).write_bytes(patch)
+ commits.append({'message':message+'\n\nCo-Authored-By: OpenAI Codex <noreply@openai.com>','files':paths,'patch':patch_name,'sha256':hashlib.sha256(patch).hexdigest()})
+changed=subprocess.check_output(['git','-c','core.fsmonitor=false','diff','HEAD','--name-only','--','crates','contracts','STATUS.md'],cwd=root,text=True).splitlines()
+assert set(changed)<=seen,set(changed)-seen
+manifest={'base':subprocess.check_output(['git','rev-parse','HEAD'],cwd=root,text=True).strip(),
+ 'git_read_only':True,'instructions':'The working tree already contains these changes: stage each listed file group and commit in order, using the complete message including its final Co-Authored-By trailer. Patches are recovery/review artifacts relative to the listed base; do not apply them over the modified working tree. The shared regression target is in the final group. No commits or index writes were attempted.',
+ 'inherited_snapshot':'inherited.patch (audit backup only; includes rejected changes; do not apply)',
+ 'commits':commits}
+(out/'manifest.json').write_text(json.dumps(manifest,indent=2)+'\n')
+print('Wrote',len(commits),'logical patch groups covering',len(seen),'files')
