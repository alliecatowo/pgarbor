+                    cols.push((vc.attnum, side.offset + i as u32, v.ty));
+                }
+            }
+        }
+    }
+    if cols.is_empty() && identity.is_none() {
+        return None;
+    }
+    cols.sort_by_key(|(attnum, _, _)| *attnum);
+    cols.dedup_by_key(|(attnum, _, _)| *attnum);
+    let args: Vec<BoundExpr> = cols.iter().map(|(_, slot, cty)| {
