+fn whole_row_from_sides(c: ColumnRef, ty: TypeId, ctx: &Ctx<'_>) -> Option<BoundExpr> {
+    let mut cols: Vec<(i16, u32, TypeId)> = Vec::new();
+    let mut identity = None;
+    for side in &ctx.sides {
+        for (i, v) in side.vars.iter().enumerate() {
