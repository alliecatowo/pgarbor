+    if let Some(h) = out.having.take() {
+        out.having = Some(simplify::simplify_expr(st, h)?);
+    }
+    for w in out.windows.iter_mut() {
+        for e in w.partition_by.iter_mut() {
+            *e = simplify::simplify_expr(st, e.clone())?;
+        }
+        for k in w.order_by.iter_mut() {
