+    let output=c.input(&["import","-","--single-transaction","--db",path(&c.db)],"CREATE TABLE copied(id int);\nCOPY copied FROM stdin;\nnot-an-integer\n\\.\n");
+    code(&output,1);
+    sqlstate(c.sql("main","SELECT * FROM copied"),"42P01");
+}
